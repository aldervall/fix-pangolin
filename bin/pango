#!/usr/bin/env bash
# pango — thin Pangolin Integration API CLI (bash + curl + jq, no other deps)
#
# Config via env: PANGOLIN_API_KEY, PANGOLIN_API_ENDPOINT, PANGOLIN_ORG_ID
# (optionally loaded from .env in the repo root).
#
# Flags:
#   --mock      use the canned mock API (mock-api.sh) instead of the live API
#   --dry-run   print the exact curl command without executing it
#   --endpoint  override API base URL
#   --org       override organization id
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

MOCK=0
DRY_RUN=0
FROM_DEFAULTS=0

# --- config ---------------------------------------------------------------
load_env() {
  local env_file="$REPO_DIR/.env"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

PANGOLIN_API_ENDPOINT="${PANGOLIN_API_ENDPOINT:-https://api.pangolin.aldervall.se}"
PANGOLIN_ORG_ID="${PANGOLIN_ORG_ID:-aldervall}"

usage() {
  cat <<'EOF'
pango — Pangolin Integration API CLI

Usage:
  pango [--mock] [--dry-run] <command> [args]

Commands:
  list <entity>          List entities: sites | resources | domains | clients |
                         users | roles | targets (targets: --resource-id N)
  create-site <name>     Create a site (--type newt|wireguard|local, default newt;
                         --from-defaults pulls address/newtId/secret first)
  create-resource <name> Create a public resource (--domain-id <id> required;
                         --subdomain <sub>; --mode http|ssh|rdp|vnc|tcp|udp)
  add-target <rid>       Attach a target to a resource (--site-id N --ip X
                         --port N required; --method http default)
  assign <rid>           Grant access (--role <id> or --user <id>, exactly one)
  apply-blueprint <file|b64>  Apply a blueprint (JSON file base64-encoded, or a
                         pre-encoded base64 payload)
apply-services <yaml>  Idempotent apply of services.yaml (default: services.yaml);
                          matches resources by full-domain; reconciles targets;
                          auto-looks-up domain by baseDomain and site by name
  apply-healthchecks <yaml>  Idempotent apply of health checks from services.yaml;
                          upserts health check per service with hcEnabled/hcMode/etc.
  help                   Show this help

Flags:
  --mock                 Use the canned mock API (mock-api.sh)
  --dry-run              Print the exact curl command, do not execute
  --endpoint URL         Override PANGOLIN_API_ENDPOINT
  --org ID               Override PANGOLIN_ORG_ID
  --resource-id N        Resource id (list targets, add-target, assign)

Env:
  PANGOLIN_API_KEY       Bearer token (required for live/mock calls)
  PANGOLIN_API_ENDPOINT  API base, default https://api.pangolin.aldervall.se
  PANGOLIN_ORG_ID        Organization id, default aldervall
EOF
}

# --- API plumbing -----------------------------------------------------------
# api_call <METHOD> <PATH> [body-json]
#   live: curl against $PANGOLIN_API_ENDPOINT/v1$PATH
#   mock: PANGOLIN_API_KEY=<key> bash mock-api.sh METHOD PATH [--body json]
#   dry-run: print the exact curl command (key redacted) and exit 0
api_call() {
  local method="$1" path="$2" body="${3:-}"

  local url="${PANGOLIN_API_ENDPOINT%/}/v1${path}"

  if [[ "$DRY_RUN" == 1 ]]; then
    printf 'curl -sS -X %s %s -H %s' "$method" "$url" \
      "'Authorization: Bearer \$PANGOLIN_API_KEY'"
    if [[ -n "$body" ]]; then
      printf ' -H %s -d %s' "'Content-Type: application/json'" "'$body'"
    fi
    printf '\n'
    return 0
  fi

  if [[ -z "${PANGOLIN_API_KEY:-}" ]]; then
    echo "error: set PANGOLIN_API_KEY (see .env.example)" >&2
    exit 1
  fi

  if [[ "$MOCK" == 1 ]]; then
    if [[ -n "$body" ]]; then
      PANGOLIN_API_KEY="$PANGOLIN_API_KEY" bash "$REPO_DIR/mock-api.sh" "$method" "$path" --body "$body"
    else
      PANGOLIN_API_KEY="$PANGOLIN_API_KEY" bash "$REPO_DIR/mock-api.sh" "$method" "$path"
    fi
    return 0
  fi

  local cmd=(curl -sS -X "$method" "$url" -H "Authorization: Bearer ${PANGOLIN_API_KEY}")
  if [[ -n "$body" ]]; then
    cmd+=(-H "Content-Type: application/json" -d "$body")
  fi
  "${cmd[@]}"
}

# check_envelope <response-json>
#   surfaces envelope errors: error:true OR status>=400 -> message to stderr, exit 1
check_envelope() {
  local resp="$1" error status message
  error="$(jq -r '.error // false' <<<"$resp")"
  status="$(jq -r '.status // 0' <<<"$resp")"
  message="$(jq -r '.message // ""' <<<"$resp")"
  if [[ "$error" == "true" || "$status" -ge 400 ]]; then
    echo "API error ($status): $message" >&2
    exit 1
  fi
}

# render_table <response-json> <entity-key> <field1> <field2> ...
#   prints a column table of data.<entity-key>[] rows
render_table() {
  local resp="$1" key="$2"
  shift 2
  local fields=("$@")
  local fields_json
  fields_json="$(printf '%s\n' "${fields[@]}" | jq -R . | jq -s .)"

  local rows
  rows="$(jq -r --arg key "$key" --argjson fields "$fields_json" '
    (.data[$key] // []) as $items
    | if ($items | length) == 0 then "NO_ROWS"
      else $items[] | [ $fields[] as $f | (. as $it | $it[$f] // "" | tostring) ] | @tsv
      end' <<<"$resp")"

  if [[ "$rows" == "NO_ROWS" ]]; then
    echo "No ${key} found"
    return 0
  fi

  printf '%s\n' "$(IFS=$'\t'; echo "${fields[*]}")"
  printf '%s\n' "$rows" | column -t -s $'\t'
}

# --- commands ---------------------------------------------------------------
# collect_all <entity-key> <path> [style]
#   style: "size" (default) uses pageSize/page; "offset" uses limit/offset
#   echoes a JSON array with all pages fetched
collect_all() {
  local key="$1" path="$2" style="${3:-size}"
  local page_size="${PANGOLIN_PAGE_SIZE:-1000}" page=1 total=1
  local resp rows collected='[]' sep

  while (( (page - 1) * page_size < total )); do
    if [[ "$path" == *\?* ]]; then sep='&'; else sep='?'; fi
    if [[ "$style" == "offset" ]]; then
      local offset=$(( (page - 1) * page_size ))
      resp="$(api_call GET "${path}${sep}limit=${page_size}&offset=${offset}")" || {
        echo "error: API call failed" >&2
        exit 1
      }
    else
      resp="$(api_call GET "${path}${sep}pageSize=${page_size}&page=${page}")" || {
        echo "error: API call failed" >&2
        exit 1
      }
    fi
    check_envelope "$resp"
    total="$(jq -r '.data.pagination.total // 1' <<<"$resp")"
    rows="$(jq -c --arg key "$key" '[.data[$key][]?]' <<<"$resp")"
    collected="$(jq -c --argjson rows "$rows" '. + $rows' <<<"$collected")"
    page=$(( page + 1 ))
  done

  printf '%s' "$collected"
}

# do_list <entity-key> <path> [style] <field1> <field2> ...
#   style: "size" (default) uses pageSize/page; "offset" uses limit/offset
#   loops pages until pagination.total is consumed, then renders
do_list() {
  local key="$1" path="$2" style="${3:-size}"
  shift 3 2>/dev/null || shift 2  # shift key, path, [style]
  if [[ "$DRY_RUN" == 1 ]]; then
    local sep='?'; [[ "$path" == *\?* ]] && sep='&'
    if [[ "$style" == "offset" ]]; then
      api_call GET "${path}${sep}limit=${PANGOLIN_PAGE_SIZE:-1000}&offset=0"
    else
      api_call GET "${path}${sep}pageSize=${PANGOLIN_PAGE_SIZE:-1000}&page=1"
    fi
    return 0
  fi
  local items wrapped
  items="$(collect_all "$key" "$path" "$style")"
  wrapped="$(jq -n --arg key "$key" --argjson items "$items" \
    '{data: {($key): $items, pagination: {total: ($items | length)}}}')"
  render_table "$wrapped" "$key" "$@"
}

cmd_list() {
  local entity="${1:-}"
  local resource_id="${RESOURCE_ID:-}"

  case "$entity" in
    sites)     do_list sites "/org/$PANGOLIN_ORG_ID/sites" siteId name type address online ;;
    resources) do_list resources "/org/$PANGOLIN_ORG_ID/resources" resourceId name subdomain fullDomain mode enabled ;;
    domains)   do_list domains "/org/$PANGOLIN_ORG_ID/domains" offset domainId baseDomain verified type ;;
    clients)   do_list clients "/org/$PANGOLIN_ORG_ID/clients" clientId name online ;;
    users)     do_list users "/org/$PANGOLIN_ORG_ID/users" userId email ;;
    roles)     do_list roles "/org/$PANGOLIN_ORG_ID/roles" roleId name description ;;
    targets)
      if [[ -z "$resource_id" ]]; then
        echo "error: list targets requires --resource-id N" >&2
        exit 2
      fi
      do_list targets "/resource/$resource_id/targets" targetId resourceId siteId ip port method
      ;;
    health-checks|healthchecks)
      do_list healthChecks "/org/$PANGOLIN_ORG_ID/health-checks" offset healthCheckId name resourceId siteId
      ;;
    *)
      echo "error: unknown entity '$entity' (sites|resources|domains|clients|users|roles|targets|health-checks)" >&2
      exit 2
      ;;
  esac
}

# --- write commands ----------------------------------------------------------
# run_write <method> <path> <body> — interactive write:
#   dry-run: print exact curl via api_call and exit 0
#   live:    execute, surface envelope, print "OK: <message>"
run_write() {
  local method="$1" path="$2" body="$3" resp
  if [[ "$DRY_RUN" == 1 ]]; then
    api_call "$method" "$path" "$body"
    return 0
  fi
  resp="$(api_call "$method" "$path" "$body")" || {
    echo "error: API call failed" >&2
    exit 1
  }
  check_envelope "$resp"
  jq -r '"OK: " + (.message // "success")' <<<"$resp"
}

# do_write <method> <path> <body> — like run_write but echoes the raw response
#   JSON instead of the message (for callers that need ids for idempotency).
#   dry-run: prints the exact curl and returns 0 WITHOUT echoing JSON.
do_write() {
  local method="$1" path="$2" body="$3" resp
  if [[ "$DRY_RUN" == 1 ]]; then
    api_call "$method" "$path" "$body"
    return 0
  fi
  resp="$(api_call "$method" "$path" "$body")" || {
    echo "error: API call failed" >&2
    exit 1
  }
  check_envelope "$resp"
  printf '%s\n' "$resp"
}

# envelope_ok <response-json> — like check_envelope but returns instead of exits
envelope_ok() {
  local resp="$1" error status message
  error="$(jq -r '.error // false' <<<"$resp")"
  status="$(jq -r '.status // 0' <<<"$resp")"
  message="$(jq -r '.message // ""' <<<"$resp")"
  if [[ "$error" == "true" || "$status" -ge 400 ]]; then
    echo "API error ($status): $message" >&2
    return 1
  fi
  return 0
}

cmd_create_site() {
  local name="$1" type="${SITE_TYPE:-newt}" body resp
  [[ -n "$name" ]] || { echo "error: create-site requires a name" >&2; exit 2; }
  case "$type" in newt|wireguard|local) ;; *) echo "error: --type must be newt|wireguard|local" >&2; exit 2 ;; esac

  if [[ "$FROM_DEFAULTS" == 1 ]]; then
    local dresp addr nt sec
    if [[ "$DRY_RUN" == 1 ]]; then
      api_call GET "/org/$PANGOLIN_ORG_ID/pick-site-defaults"
      body="$(jq -n --arg name "$name" --arg type "$type" \
        --arg address '<from-pick-site-defaults>' --arg newtId '<from-pick-site-defaults>' \
        --arg secret '<from-pick-site-defaults>' \
        '{name:$name, type:$type, address:$address, newtId:$newtId, secret:$secret}')"
      run_write PUT "/org/$PANGOLIN_ORG_ID/site" "$body"
      return 0
    fi
    dresp="$(api_call GET "/org/$PANGOLIN_ORG_ID/pick-site-defaults")" || exit 1
    check_envelope "$dresp"
    addr="$(jq -r '.data.address // ""' <<<"$dresp")"
    nt="$(jq -r '.data.newtId // ""' <<<"$dresp")"
    sec="$(jq -r '.data.secret // ""' <<<"$dresp")"
    body="$(jq -n --arg name "$name" --arg type "$type" \
      --arg address "$addr" --arg newtId "$nt" --arg secret "$sec" \
      '{name:$name, type:$type, address:$address, newtId:$newtId, secret:$secret}')"
    run_write PUT "/org/$PANGOLIN_ORG_ID/site" "$body"
    return 0
  fi

  body="$(jq -n --arg name "$name" --arg type "$type" '{name:$name, type:$type}')"
  run_write PUT "/org/$PANGOLIN_ORG_ID/site" "$body"
}

cmd_create_resource() {
  local name="$1" domain_id="${DOMAIN_ID:-}" subdomain="${SUBDOMAIN:-}" mode="${MODE:-http}" body
  [[ -n "$name" ]] || { echo "error: create-resource requires a name" >&2; exit 2; }
  [[ -n "$domain_id" ]] || { echo "error: create-resource requires --domain-id <id>" >&2; exit 2; }
  case "$mode" in http|ssh|rdp|vnc|tcp|udp) ;; *) echo "error: --mode must be http|ssh|rdp|vnc|tcp|udp" >&2; exit 2 ;; esac

  body="$(jq -n --arg name "$name" --arg domainId "$domain_id" \
    --arg subdomain "$subdomain" --arg mode "$mode" \
    '{name:$name, domainId:$domainId, mode:$mode, subdomain:$subdomain}')"
  run_write PUT "/org/$PANGOLIN_ORG_ID/resource" "$body"
}

cmd_add_target() {
  local rid="${1:-}" site_id="${SITE_ID:-}" ip="${IP:-}" port="${PORT:-}" method="${METHOD:-http}" body
  [[ -n "$rid" ]] || { echo "error: add-target requires <resource-id>" >&2; exit 2; }
  [[ -n "$site_id" && -n "$ip" && -n "$port" ]] || {
    echo "error: add-target requires --site-id N --ip X --port N" >&2; exit 2; }
  [[ "$site_id" =~ ^[0-9]+$ ]] || { echo "error: --site-id must be numeric" >&2; exit 2; }
  [[ "$port" =~ ^[0-9]+$ ]] || { echo "error: --port must be numeric" >&2; exit 2; }

  body="$(jq -n --argjson siteId "$site_id" --arg ip "$ip" --argjson port "$port" \
    --arg method "$method" '{siteId:$siteId, ip:$ip, port:$port, method:$method}')"
  run_write PUT "/resource/$rid/target" "$body"
}

cmd_assign() {
  local rid="${1:-}" role="${ROLE:-}" user="${USER_ID:-}" body
  [[ -n "$rid" ]] || { echo "error: assign requires <resource-id>" >&2; exit 2; }
  if [[ -n "$role" && -n "$user" ]]; then
    echo "error: assign takes exactly one of --role or --user" >&2; exit 2
  fi
  if [[ -n "$role" ]]; then
    [[ "$role" =~ ^[0-9]+$ ]] || { echo "error: --role must be numeric" >&2; exit 2; }
    body="$(jq -n --argjson roleId "$role" '{roleId:$roleId}')"
    run_write POST "/resource/$rid/roles/add" "$body"
  elif [[ -n "$user" ]]; then
    body="$(jq -n --arg userId "$user" '{userId:$userId}')"
    run_write POST "/resource/$rid/users/add" "$body"
  else
    echo "error: assign requires --role <id> or --user <id>" >&2; exit 2
  fi
}

cmd_apply_blueprint() {
  local payload="${1:-}" blueprint body
  [[ -n "$payload" ]] || {
    echo "error: apply-blueprint requires a file path or pre-encoded base64 payload" >&2; exit 2; }
  if [[ -f "$payload" ]]; then
    blueprint="$(base64 -w0 "$payload")"
  else
    [[ "$payload" =~ ^[A-Za-z0-9+/=]+$ ]] || {
      echo "error: payload is neither an existing file nor valid base64" >&2; exit 2; }
    blueprint="$payload"
  fi
  body="$(jq -n --arg blueprint "$blueprint" '{blueprint:$blueprint}')"
  run_write PUT "/org/$PANGOLIN_ORG_ID/blueprint" "$body"
}

# yaml_to_json <file> — YAML -> JSON via yq or python3+PyYAML
yaml_to_json() {
  local file="$1"
  if command -v yq >/dev/null 2>&1; then
    yq e -o=json '.' "$file" 2>/dev/null && return 0
  fi
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' 2>/dev/null; then
    python3 - "$file" <<'PYEOF'
import sys, json, yaml
with open(sys.argv[1]) as f:
    print(json.dumps(yaml.safe_load(f)))
PYEOF
    return 0
  fi
  echo "error: services.yaml needs yq or python3+PyYAML for YAML parsing" >&2
  return 1
}

# cmd_apply_services <services.yaml> — idempotent by full-domain:
#   resource exists -> reconcile targets (add missing, never duplicate)
#   resource missing -> create resource then add targets
cmd_apply_services() {
  local file="${1:-services.yaml}"
  [[ -f "$file" ]] || { echo "error: services file not found: $file" >&2; exit 2; }

  local svcs
  svcs="$(yaml_to_json "$file")" || exit 2
  svcs="$(jq -c 'if type == "array" then . elif .services then .services else [.] end' <<<"$svcs")"

  local sites domains resources
  if [[ "$DRY_RUN" == 1 ]]; then
    # dry-run cannot resolve live state; empty arrays let the loop
    # print write curls with <placeholder> ids instead of failing
    sites='[]'; domains='[]'; resources='[]'
    api_call GET "/org/$PANGOLIN_ORG_ID/sites?pageSize=1000&page=1"
    api_call GET "/org/$PANGOLIN_ORG_ID/domains?limit=1000&offset=0"
    api_call GET "/org/$PANGOLIN_ORG_ID/resources?pageSize=1000&page=1"
    echo "# apply-services dry-run: prints each write curl below"
  else
    sites="$(collect_all sites "/org/$PANGOLIN_ORG_ID/sites")"
    domains="$(collect_all domains "/org/$PANGOLIN_ORG_ID/domains" offset)"
    resources="$(collect_all resources "/org/$PANGOLIN_ORG_ID/resources")"
  fi

  local n i
  n="$(jq 'length' <<<"$svcs")"
  local created=0 updated=0 skipped=0 failed=0

  for (( i=0; i<n; i++ )); do
    local svc name full_domain domain_id subdomain mode
    svc="$(jq -c --argjson i "$i" '.[$i]' <<<"$svcs")"
    name="$(jq -r '.name // empty' <<<"$svc")"
    full_domain="$(jq -r '."full-domain" // empty' <<<"$svc")"
    if [[ -z "$name" || -z "$full_domain" ]]; then
      echo "SKIP  service #$((i+1)): missing name or full-domain"
      skipped=$((skipped+1)); continue
    fi

    # resolve domain-id: explicit, else auto-lookup by baseDomain suffix.
    # NOTE: bind .baseDomain via `as $b` BEFORE the pipe — jq evaluates a
    # function-call argument in the context of the piped input ($fd, a string),
    # so `.baseDomain` inside endswith() there would index a string (fatal in jq>=1.8).
    domain_id="$(jq -r '."domain-id" // empty' <<<"$svc")"
    if [[ -z "$domain_id" ]]; then
      domain_id="$(jq -n -r --argjson data "$domains" --arg fd "$full_domain" '
        [$data[] | select(has("baseDomain") and (.baseDomain as $b |
          ($fd | endswith("." + $b)) or ($fd == $b)))]
        | if length == 0 then "" else ((map(select(has("type") and .type == "wildcard"))[0]) // (.[0])).domainId end')"
    fi
    if [[ -z "$domain_id" ]]; then
      if [[ "$DRY_RUN" == 1 ]]; then
        domain_id="<domain-id-for:$full_domain>"
      else
        echo "FAIL  $name: no domain matches $full_domain (set domain-id)" >&2
        failed=$((failed+1)); continue
      fi
    fi

    # subdomain: explicit, else derived from full-domain minus baseDomain
    subdomain="$(jq -r '.subdomain // empty' <<<"$svc")"
    if [[ -z "$subdomain" && "$DRY_RUN" != 1 ]]; then
      subdomain="$(jq -n -r --argjson data "$domains" --arg fd "$full_domain" --arg d "$domain_id" '
        (([$data[] | select(has("domainId") and .domainId == $d)][0].baseDomain) // "") as $bd
        | if $bd != "" and ($fd | endswith("." + $bd)) then $fd | rtrimstr("." + $bd) else "" end')"
    fi

    # pre-validate targets before any writes (avoid orphan resources when a
    # site name is unknown — the resource would otherwise be created first)
    local n_pre j_pre tgt_pre site_pre host_pre port_pre sid_pre pre_err=0
    n_pre="$(jq '.targets | length' <<<"$svc")"
    for (( j_pre=0; j_pre<n_pre; j_pre++ )); do
      tgt_pre="$(jq -c --argjson j "$j_pre" '.targets[$j]' <<<"$svc")"
      site_pre="$(jq -r '.site // empty' <<<"$tgt_pre")"
      host_pre="$(jq -r '.hostname // empty' <<<"$tgt_pre")"
      port_pre="$(jq -r '.port // empty' <<<"$tgt_pre")"
      if [[ -z "$site_pre" || -z "$host_pre" || -z "$port_pre" ]]; then
        echo "  ! $name: target #$((j_pre+1)) missing site/hostname/port" >&2
        pre_err=1; continue
      fi
      if [[ "$DRY_RUN" == 1 ]]; then continue; fi
      sid_pre="$(jq -n -r --argjson data "$sites" --arg n "$site_pre" \
        '[$data[] | select(has("name") and .name == $n)][0].siteId // ""')"
      if [[ -z "$sid_pre" ]]; then
        echo "  ! $name: site not found: $site_pre" >&2
        pre_err=1
      fi
    done
    if [[ "$pre_err" == 1 ]]; then
      echo "FAIL  $name ($full_domain)" >&2
      failed=$((failed+1)); continue
    fi

    # existing resource by fullDomain?
    local existing rid status
    existing="$(jq -n -c --argjson data "$resources" --arg fd "$full_domain" \
      '[$data[] | select(has("fullDomain") and .fullDomain == $fd)][0] // empty')"
    if [[ -n "$existing" ]]; then
      rid="$(jq -r '.resourceId' <<<"$existing")"
      status="updated"
    else
      status="created"
      mode="$(jq -r '.mode // "http"' <<<"$svc")"
      local body resp
      body="$(jq -n --arg name "$name" --arg domainId "$domain_id" --arg mode "$mode" \
        --arg subdomain "$subdomain" \
        '{name:$name, domainId:$domainId, mode:$mode, subdomain:$subdomain}')"
      if [[ "$DRY_RUN" == 1 ]]; then
        rid="<new-resource-id>"
        run_write PUT "/org/$PANGOLIN_ORG_ID/resource" "$body"
      else
        resp="$(do_write PUT "/org/$PANGOLIN_ORG_ID/resource" "$body")" || { failed=$((failed+1)); continue; }
        rid="$(jq -r '.data.resourceId // empty' <<<"$resp")"
      fi
    fi

    # reconcile targets (skip existing siteId+ip+port matches; no update endpoint)
    local existing_targets n2 j2 added=0 terr=0
    existing_targets='[]'
    if [[ "$status" == "updated" && "$DRY_RUN" != 1 ]]; then
      existing_targets="$(collect_all targets "/resource/$rid/targets")"
    fi
    n2="$(jq '.targets | length' <<<"$svc")"
    for (( j2=0; j2<n2; j2++ )); do
      local tgt site_name hostname port method site_id
      tgt="$(jq -c --argjson j "$j2" '.targets[$j]' <<<"$svc")"
      site_name="$(jq -r '.site // empty' <<<"$tgt")"
      hostname="$(jq -r '.hostname // empty' <<<"$tgt")"
      port="$(jq -r '.port // empty' <<<"$tgt")"
      method="$(jq -r '.method // "http"' <<<"$tgt")"
      if [[ -z "$site_name" || -z "$hostname" || -z "$port" ]]; then
        echo "  ! $name: target #$((j2+1)) missing site/hostname/port" >&2
        terr=1; continue
      fi
      site_id="$(jq -n -r --argjson data "$sites" --arg n "$site_name" \
        '[$data[] | select(has("name") and .name == $n)][0].siteId // ""')"
      if [[ -z "$site_id" ]]; then
        if [[ "$DRY_RUN" == 1 ]]; then
          site_id="<site-id-for:$site_name>"
        else
          echo "  ! $name: site not found: $site_name" >&2
          terr=1; continue
        fi
      fi
      if [[ "$status" == "updated" && "$DRY_RUN" != 1 ]] && \
         jq -ne --argjson data "$existing_targets" --argjson sid "$site_id" \
           --arg h "$hostname" --argjson p "$port" \
           '[$data[] | select(.siteId == $sid and .ip == $h and .port == $p)] | length > 0' \
           >/dev/null 2>&1; then
        continue
      fi
      local tbody
      if [[ "$DRY_RUN" == 1 ]]; then
        # placeholder ids are strings; the curl body is display-only
        tbody="$(jq -n --arg siteId "$site_id" --arg ip "$hostname" --arg port "$port" \
          --arg method "$method" '{siteId:$siteId, ip:$ip, port:$port, method:$method}')"
      else
        tbody="$(jq -n --argjson siteId "$site_id" --arg ip "$hostname" --argjson port "$port" \
          --arg method "$method" '{siteId:$siteId, ip:$ip, port:$port, method:$method}')"
      fi
      if [[ "$DRY_RUN" == 1 ]]; then
        run_write PUT "/resource/$rid/target" "$tbody"
      else
        # do_write prints the raw response and exits nonzero on error envelopes
        do_write PUT "/resource/$rid/target" "$tbody" >/dev/null || { terr=1; continue; }
      fi
      added=$((added+1))
    done

    if [[ "$terr" == 1 ]]; then
      echo "FAIL  $name ($full_domain)" >&2
      failed=$((failed+1))
    elif [[ "$DRY_RUN" == 1 ]]; then
      echo "WOULD $status $name ($full_domain) [+$added targets]"
    elif [[ "$status" == "created" ]]; then
      echo "CREATED $name ($full_domain) [+$added targets]"
      created=$((created+1))
    else
      echo "UPDATED $name ($full_domain) [targets reconciled: +$added added]"
      updated=$((updated+1))
    fi
  done

  [[ "$DRY_RUN" == 1 ]] && return 0
  echo ""
  echo "Summary: $created created, $updated updated, $skipped skipped, $failed failed"
  [[ "$failed" == 0 ]] || exit 1
}

# cmd_apply_healthchecks <services.yaml> — idempotent upsert of health checks:
#   For each service with a healthcheck block:
#     1. Resolve resourceId by fullDomain from collect_all resources
#     2. Resolve siteId from the service's FIRST target's site NAME via collect_all sites
#        (if no targets or site unknown → SKIP that service, never fail the whole run)
#     3. List existing health checks by fullDomain match
#     4. If found → PUT /org/{org}/health-check/{id} (update)
#        If not found → PUT /org/{org}/health-check (create)
#     5. Body: name, siteId, hcEnabled:true, hcMode:"http", hcHostname, hcPort,
#        hcPath:"/", hcScheme:"http", hcMethod:"GET",
#        hcInterval (default 30), hcTimeout (default 1), hcUnhealthyThreshold (default 1)
cmd_apply_healthchecks() {
  local file="${1:-services.yaml}"
  [[ -f "$file" ]] || { echo "error: healthcheck file not found: $file" >&2; exit 2; }

  local svcs
  svcs="$(yaml_to_json "$file")" || exit 2
  svcs="$(jq -c 'if type == "array" then . elif .services then .services else [.] end' <<<"$svcs")"

  local sites resources healthChecks
  if [[ "$DRY_RUN" == 1 ]]; then
    # dry-run: empty arrays let the loop print write curls with placeholder ids
    sites='[]'; resources='[]'; healthChecks='[]'
    api_call GET "/org/$PANGOLIN_ORG_ID/sites?pageSize=1000&page=1"
    api_call GET "/org/$PANGOLIN_ORG_ID/resources?pageSize=1000&page=1"
    api_call GET "/org/$PANGOLIN_ORG_ID/health-checks?limit=1000&offset=0"
    echo "# apply-healthchecks dry-run: prints each write curl below"
  else
    sites="$(collect_all sites "/org/$PANGOLIN_ORG_ID/sites")"
    resources="$(collect_all resources "/org/$PANGOLIN_ORG_ID/resources")"
    healthChecks="$(collect_all healthChecks "/org/$PANGOLIN_ORG_ID/health-checks" offset)"
  fi

  local n i created=0 updated=0 skipped=0 failed=0
  n="$(jq 'length' <<<"$svcs")"

  for (( i=0; i<n; i++ )); do
    local svc name full_domain
    svc="$(jq -c --argjson i "$i" '.[$i]' <<<"$svcs")"
    name="$(jq -r '.name // empty' <<<"$svc")"
    full_domain="$(jq -r '."full-domain" // empty' <<<"$svc")"
    if [[ -z "$name" || -z "$full_domain" ]]; then
      echo "SKIP  $name: missing name or full-domain"; skipped=$((skipped+1)); continue
    fi

    # --- resolve resourceId by fullDomain (same pattern as cmd_apply_services) ---
    local resourceId
    resourceId="$(jq -n -c --argjson data "$resources" --arg fd "$full_domain" \
      '[$data[] | select(has("fullDomain") and .fullDomain == $fd)][0].resourceId // empty')"
    if [[ -z "$resourceId" ]]; then
      echo "SKIP  $name: no resource matches $full_domain"; skipped=$((skipped+1)); continue
    fi

    # --- resolve siteId from FIRST target's site name ---
    local first_hostname first_port first_site
    first_hostname="$(jq -r '.targets[0].hostname // empty' <<<"$svc")"
    first_port="$(jq -r '.targets[0].port // empty' <<<"$svc")"
    first_site="$(jq -r '.targets[0].site // empty' <<<"$svc")"

    if [[ -z "$first_hostname" || -z "$first_port" || -z "$first_site" ]]; then
      echo "SKIP  $name: no resolvable site (missing target hostname/port)"; skipped=$((skipped+1)); continue
    fi

    siteId="$(jq -n -r --argjson data "$sites" --arg n "$first_site" \
      '[$data[] | select(has("name") and .name == $n)][0].siteId // ""')"
    if [[ -z "$siteId" ]]; then
      echo "SKIP  $name: no resolvable site: $first_site"; skipped=$((skipped+1)); continue
    fi

    # --- resolve healthcheck parameters ---
    local hc_interval hc_timeout hc_retries
    hc_interval="$(jq -r '.interval // 30' <<<"$svc")"
    hc_timeout="$(jq -r '.timeout // 1' <<<"$svc")"
    hc_retries="$(jq -r '.retries // 1' <<<"$svc")"

    # --- list existing health checks, match by name ---
    local existing_hc_id
    existing_hc_id="$(jq -n -c --argjson data "$healthChecks" --arg n "$name" \
      '[$data[] | select(.name == $n)][0].healthCheckId // empty')"
    if [[ -n "$existing_hc_id" ]]; then
      # UPDATE: POST to /org/{org}/health-check/{id}
      local hc_body hc_update_path
      hc_body="$(jq -n --arg name "$name" --argjson siteId "$siteId" \
        --argjson hcInterval "$hc_interval" \
        --argjson hcTimeout "$hc_timeout" \
        --argjson hcUnhealthyThreshold "$hc_retries" \
        --arg hcHostname "$first_hostname" \
        --argjson hcPort "$first_port" \
        '{name:$name, siteId:$siteId, hcEnabled:true, hcMode:"http", hcHostname:$hcHostname, hcPort:$hcPort, hcPath:"/", hcScheme:"http", hcMethod:"GET", hcInterval:$hcInterval, hcTimeout:$hcTimeout, hcUnhealthyThreshold:$hcUnhealthyThreshold}')"
      if [[ "$DRY_RUN" == 1 ]]; then
        api_call PUT "/org/$PANGOLIN_ORG_ID/health-check/$existing_hc_id" "$hc_body"
        echo "WOULD UPDATE $name"
      else
        resp="$(api_call PUT "/org/$PANGOLIN_ORG_ID/health-check/$existing_hc_id" "$hc_body")" || { failed=$((failed+1)); continue; }
        check_envelope "$resp"
        echo "UPDATED $name"
      fi
    else
      # CREATE: PUT /org/{org}/health-check
      local hc_body
      hc_body="$(jq -n --arg name "$name" --argjson siteId "$siteId" \
        --argjson hcInterval "$hc_interval" \
        --argjson hcTimeout "$hc_timeout" \
        --argjson hcUnhealthyThreshold "$hc_retries" \
        --arg hcHostname "$first_hostname" \
        --argjson hcPort "$first_port" \
        '{name:$name, siteId:$siteId, hcEnabled:true, hcMode:"http", hcHostname:$hcHostname, hcPort:$hcPort, hcPath:"/", hcScheme:"http", hcMethod:"GET", hcInterval:$hcInterval, hcTimeout:$hcTimeout, hcUnhealthyThreshold:$hcUnhealthyThreshold}')"
      if [[ "$DRY_RUN" == 1 ]]; then
        api_call PUT "/org/$PANGOLIN_ORG_ID/health-check" "$hc_body"
        echo "WOULD CREATE $name"
      else
        resp="$(api_call PUT "/org/$PANGOLIN_ORG_ID/health-check" "$hc_body")" || { failed=$((failed+1)); continue; }
        check_envelope "$resp"
        echo "CREATED $name"
      fi
    fi

    if [[ "$DRY_RUN" != 1 ]]; then
      # In live/mock mode, track counts
      if [[ -n "$existing_hc_id" ]]; then
        updated=$((updated+1))
      else
        created=$((created+1))
      fi
    fi
  done

  if [[ "$DRY_RUN" == 1 ]]; then
    echo ""
    echo "Summary: $created created, $updated updated, $skipped skipped, $failed failed"
    return 0
  fi
  echo ""
  echo "Summary: $created created, $updated updated, $skipped skipped, $failed failed"
  [[ "$failed" == 0 ]] || exit 1
}

# --- main -------------------------------------------------------------------
main() {
  load_env

  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mock) MOCK=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --endpoint) PANGOLIN_API_ENDPOINT="$2"; shift 2 ;;
      --org) PANGOLIN_ORG_ID="$2"; shift 2 ;;
      --resource-id) RESOURCE_ID="$2"; shift 2 ;;
      --type) SITE_TYPE="$2"; shift 2 ;;
      --from-defaults) FROM_DEFAULTS=1; shift ;;
      --domain-id) DOMAIN_ID="$2"; shift 2 ;;
      --subdomain) SUBDOMAIN="$2"; shift 2 ;;
      --mode) MODE="$2"; shift 2 ;;
      --site-id) SITE_ID="$2"; shift 2 ;;
      --ip) IP="$2"; shift 2 ;;
      --port) PORT="$2"; shift 2 ;;
      --method) METHOD="$2"; shift 2 ;;
      --role) ROLE="$2"; shift 2 ;;
      --user) USER_ID="$2"; shift 2 ;;
      help|-h|--help) usage; exit 0 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  set -- "${args[@]}"

  local command="${1:-}"
  case "$command" in
    list) cmd_list "${2:-}" ;;
    create-site) cmd_create_site "${2:-}" ;;
    create-resource) cmd_create_resource "${2:-}" ;;
    add-target) cmd_add_target "${2:-}" ;;
    assign) cmd_assign "${2:-}" ;;
    apply-blueprint) cmd_apply_blueprint "${2:-}" ;;
    apply-services) cmd_apply_services "${2:-services.yaml}" ;;
    apply-healthchecks) cmd_apply_healthchecks "${2:-services.yaml}" ;;
    "")
      usage
      exit 2
      ;;
    *)
      echo "error: unknown command '$command' (see: pango help)" >&2
      exit 2
      ;;
  esac
}

main "$@"
